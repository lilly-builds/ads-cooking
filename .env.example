# Copy this to your config folder as .env and fill it in.
# That folder is ./ads-cooking/ in your project, or ~/.ads-cooking/, or wherever
# $ADS_COOKING_HOME points. It must never be committed.
#
# Nothing here has a default. If a value is missing, every command stops
# before it reaches Meta rather than guessing which account you meant.

# Business Settings, Users, System users, your user, Generate token.
# Scopes needed: ads_management, leads_retrieval, pages_show_list, pages_manage_ads
META_SYSTEM_USER_TOKEN=

# Ads Manager, top left. With or without the act_ prefix, both work.
META_AD_ACCOUNT_ID=

# The Facebook Page the ads run from. Page settings, About, Page ID.
META_PAGE_ID=
